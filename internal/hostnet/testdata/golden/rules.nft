#!/usr/sbin/nft -f
# Written by codecheck-sandbox setup; uninstall removes it.
#
# The first two lines make loading this file one atomic replacement on any
# nftables version: create the table if missing, delete it, define it afresh.
table inet codecheck
delete table inet codecheck

table inet codecheck {
	chain input {
		type filter hook input priority filter - 10; policy accept;
		# The review VM may reach the egress proxy, and nothing else.
		iifname "cc-tap0" ip saddr 172.16.0.2 ip daddr 172.16.0.1 tcp dport 3180 accept
		iifname "cc-tap*" drop
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "cc-tap*" drop
		oifname "cc-tap*" drop
	}
}
