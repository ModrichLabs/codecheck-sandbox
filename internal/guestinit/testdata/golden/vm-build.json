{
  "boot-source": {
    "kernel_image_path": "vmlinux",
    "initrd_path": "init.cpio",
    "boot_args": "console=ttyS0 reboot=k panic=1 quiet"
  },
  "drives": [
    {
      "drive_id": "base",
      "path_on_host": "base.squashfs",
      "is_root_device": false,
      "is_read_only": true
    },
    {
      "drive_id": "config",
      "path_on_host": "config.img",
      "is_root_device": false,
      "is_read_only": true
    },
    {
      "drive_id": "inputs",
      "path_on_host": "inputs.ext4",
      "is_root_device": false,
      "is_read_only": true
    },
    {
      "drive_id": "target",
      "path_on_host": "rootfs.ext4",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 1024,
    "smt": false
  }
}
