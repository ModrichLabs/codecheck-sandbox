#!/bin/bash
# cc-claude runs one CodeCheck review inside the sandbox guest. cc-guestinit
# starts it as the agent account, in a clean environment that carries the run
# settings as CC_* variables. Claude gets read-only tools and no shell: the
# flags below follow spec §6, and assets tests hold them to it.
set -euo pipefail

die() {
	printf 'cc-claude: %s\n' "$1" >&2
	exit 2
}

budget=${CC_MAX_BUDGET_USD:-}
scope=${CC_SCOPE:-}
[[ $budget =~ ^[0-9]{1,4}(\.[0-9]{1,2})?$ ]] || die "CC_MAX_BUDGET_USD: want a decimal amount"

src=/work/src
change=/work/change
case $scope in
full)
	prompt="Run a security review of $src."
	;;
diff)
	base=${CC_BASE:-}
	[[ $base =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || die "CC_BASE: want a full commit hash"
	# The guest has no git for Claude to run, so the host precomputes the
	# change (spec amendment 9).
	prompt="Run a diff-aware security review of $src for the change from baseline commit $base. \
This sandbox gives you no shell and no git: instead of running git diff and git status, read \
$change/diff.patch (the output of git diff $base) and $change/status.txt (the output of \
git status --porcelain), and give both paths to every sub-agent in place of those commands."
	;;
*)
	die "CC_SCOPE: want full or diff"
	;;
esac

# The proxy swaps the placeholder for the real key; the guest never holds one.
export ANTHROPIC_API_KEY=sk-ant-sandbox-placeholder
export HTTPS_PROXY=http://172.16.0.1:3180
export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/codecheck-sandbox.crt
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_AUTOUPDATER=1
# Claude Code may still run git itself for context: no system or global
# config, and safe.directory from the command scope, which git trusts.
export GIT_CONFIG_NOSYSTEM=1
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0=$src

cd "$src"
exec /usr/local/bin/claude -p "$prompt" \
	--restricted \
	--strict-mcp-config \
	--tools Read,Grep,Glob,Agent,Skill \
	--allowedTools Read,Grep,Glob,Agent,Skill \
	--plugin-dir /opt/codecheck/plugin \
	--permission-mode dontAsk \
	--max-budget-usd "$budget" \
	--no-session-persistence \
	--output-format stream-json \
	--verbose
