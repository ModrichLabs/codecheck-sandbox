#!/bin/bash
# cc-selftest tries each way out of the sandbox from inside the guest, as the
# agent account that reviews run under. Every "blocked" probe must fail to get
# out, and every "allowed" probe must work. It prints one PASS or FAIL line per
# probe, then a SUMMARY line, and exits 1 when any probe fails.
#
# Sourcing the file defines the helpers without running a probe, which the
# assets tests rely on.

proxy_host=172.16.0.1
proxy_port=3180
guest_nic=eth0
passed=0
failed=0

# record prints one verdict line and counts it.
record() {
	local verdict=$1 id=$2 what=$3
	printf '%s %s %s\n' "$verdict" "$id" "$what"
	if [[ $verdict == PASS ]]; then
		passed=$((passed + 1))
	else
		failed=$((failed + 1))
	fi
}

# blocked ID WHAT CMD...: passes when CMD fails.
blocked() {
	local id=$1 what=$2
	shift 2
	if "$@" >/dev/null 2>&1; then
		record FAIL "$id" "$what"
	else
		record PASS "$id" "$what"
	fi
}

# allowed ID WHAT CMD...: passes when CMD succeeds.
allowed() {
	local id=$1 what=$2
	shift 2
	if "$@" >/dev/null 2>&1; then
		record PASS "$id" "$what"
	else
		record FAIL "$id" "$what"
	fi
}

# summary prints the totals and exits 1 when anything failed.
summary() {
	printf 'SUMMARY %d passed, %d failed\n' "$passed" "$failed"
	((failed == 0))
}

# tcp_open HOST PORT: succeeds when a TCP connection opens within 5 seconds.
tcp_open() {
	timeout 5 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$1" "$2"
}

# connect_ok HOST: succeeds when the proxy answers CONNECT HOST:443 with 200.
connect_ok() {
	local status
	status=$(timeout 10 bash -c '
		exec 3<>"/dev/tcp/$1/$2"
		printf "CONNECT %s:443 HTTP/1.1\r\nHost: %s:443\r\n\r\n" "$3" "$3" >&3
		head -n 1 <&3' _ "$proxy_host" "$proxy_port" "$1") || return 1
	[[ $status =~ ^HTTP/1\.[01]\ 200 ]]
}

# host_ports lists the host ports to try: common services, Docker's API and
# any ports the host passed in (such as Docker-published ones), never the
# proxy's own. It refuses anything but plain port numbers.
host_ports() {
	local -a ports=(22 25 53 80 443 2375 2376 3000 3128 5000 5432 6379 8000 8080 8443 9090 11434)
	local p extra=()
	if [[ -n ${CC_PROBE_PORTS:-} ]]; then
		IFS=, read -r -a extra <<<"$CC_PROBE_PORTS"
		for p in "${extra[@]}"; do
			[[ $p =~ ^[0-9]{1,5}$ ]] || {
				echo "cc-selftest: CC_PROBE_PORTS: want port numbers" >&2
				return 2
			}
		done
	fi
	printf '%s\n' "${ports[@]}" "${extra[@]}" | sort -un | grep -vx "$proxy_port" | tr '\n' ' '
	echo
}

# has_output CMD...: succeeds when CMD prints anything.
has_output() {
	[[ -n $("$@" 2>/dev/null) ]]
}

main() {
	local ports p
	ports=$(host_ports) || exit 2

	# The eight original probes.
	blocked no-direct-internet "no direct connection to the internet" tcp_open 1.1.1.1 443
	blocked no-host-ssh "no SSH to the host" tcp_open "$proxy_host" 22
	blocked no-dns "no name lookups" timeout 5 getent hosts example.com
	blocked proxy-blocks-github "the proxy refuses other hosts" connect_ok github.com
	blocked work-read-only "the source stays read-only" touch /work/.cc-selftest
	blocked root-read-only "the root disk stays read-only" touch /usr/.cc-selftest
	blocked config-hidden "the config device stays root-only" head -c 1 /dev/vdb
	allowed proxy-allows-anthropic "the proxy tunnels to the Anthropic API" connect_ok api.anthropic.com

	# Every other port on the host, and the same ports on Docker's bridge.
	for p in $ports; do
		blocked "host-port-$p" "no connection to host port $p" tcp_open "$proxy_host" "$p"
	done
	for p in $ports; do
		blocked "docker-bridge-$p" "no connection to Docker's bridge on port $p" tcp_open 172.17.0.1 "$p"
	done

	# Address and routing controls.
	blocked no-ipv6 "no IPv6 address, link-local included" has_output ip -6 -o addr show dev "$guest_nic"
	blocked no-default-route "no default route" has_output ip -4 route show default
	blocked no-spoofed-source "no extra source address" ip addr add 172.16.0.3/30 dev "$guest_nic"
	blocked no-sudo "no way back to root" sudo -n true

	summary
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
